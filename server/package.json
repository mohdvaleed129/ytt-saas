{
  "name": "ytt-server",
  "version": "0.1.0",
  "private": true,
  "description": "YouTube Transcript Generator: production API server (P1 foundation).",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
