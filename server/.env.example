# Copy to .env (git-ignored) and fill in. This file must contain names and safe placeholders only.

NODE_ENV=development
PORT=8080
# Dev default is 127.0.0.1 (local only). Production defaults to 0.0.0.0.
# HOST=127.0.0.1
LOG_LEVEL=info

# Required. A DEVELOPMENT database only (local MongoDB or an Atlas M0 dev cluster). Never production data.
# Local example: mongodb://127.0.0.1:27017/ytt_dev. For Atlas, paste the connection string from your M0 DEV cluster.
MONGODB_URI=

# How long to wait for MongoDB at startup before failing fast (milliseconds).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Comma-separated browser origins allowed to call the API. No wildcards. Production requires https.
CORS_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the app (0 locally, 1 behind Render's proxy).
TRUST_PROXY=0

BODY_LIMIT_KB=100
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# P1 supports only the in-memory mock provider. It cannot run with NODE_ENV=production.
TRANSCRIPTION_PROVIDER=mock
